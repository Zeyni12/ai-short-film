
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/the-clean-sieve/storyboard.schema.json",
  "title": "The Clean Sieve Storyboard",
  "description": "Validation contract for the deterministic AI short-film pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "character_sheet",
    "visual_identity",
    "music",
    "shots"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language",
        "voice_name",
        "end_card_text"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "am-ET"
        },
        "voice_name": {
          "type": "string",
          "minLength": 1
        },
        "end_card_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "character_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "seed"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 20
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "elder",
        "young_man",
        "sieve",
        "continuity_rules"
      ],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 10
        },
        "elder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "clothing",
            "expression"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 10
            },
            "clothing": {
              "type": "string",
              "minLength": 10
            },
            "expression": {
              "type": "string"
            }
          }
        },
        "young_man": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "clothing",
            "expression"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 10
            },
            "clothing": {
              "type": "string",
              "minLength": 10
            },
            "expression": {
              "type": "string"
            }
          }
        },
        "sieve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "condition"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 10
            },
            "condition": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dirty",
                "clean"
              ],
              "properties": {
                "dirty": {
                  "type": "string"
                },
                "clean": {
                  "type": "string"
                }
              }
            }
          }
        },
        "continuity_rules": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_candidate",
        "prompt",
        "bpm",
        "duration_sec"
      ],
      "properties": {
        "selected_candidate": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "minLength": 10
        },
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_sec",
          "image_prompt",
          "motion_prompt",
          "motion_mode",
          "narration",
          "subtitle_en",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_0[1-8]$"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "image_prompt": {
            "type": "string",
            "minLength": 20
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 10
          },
          "motion_mode": {
            "type": "string",
            "enum": [
              "ken_burns_in",
              "ken_burns_out",
              "pan_right",
              "pan_left",
              "wan22"
            ]
          },
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "subtitle_en": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
